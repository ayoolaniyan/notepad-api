{
  "name": "@notepad/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared types, HTTP helpers and JWT verification for notepad-api services",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "express": "^5.0.0",
    "joi": "^18.0.0",
    "jsonwebtoken": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "express": "^5.3.0",
    "joi": "^18.1.2",
    "jsonwebtoken": "^9.0.3",
    "typescript": "^6.0.3"
  }
}
