NODE_ENV=development
PORT=3001
# Direct PostgreSQL connection string (used by the app via @prisma/adapter-pg and by Prisma CLI)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/notepad_auth?schema=public"

# Signing secret for access tokens, at least 32 chars: openssl rand -base64 48
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Per-account lockout: failed logins allowed per email before it's blocked (any IP)
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_WINDOW_MINUTES=15

# Only the gateway should be reachable; in production bind to an internal interface
# HOST=127.0.0.1
