NODE_ENV=development
PORT=3002
# Separate database from auth-service (the same Postgres server is fine)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/notepad_notes?schema=public"

# Must match auth-service exactly, or every access token is rejected
JWT_ACCESS_SECRET=
JWT_ISSUER=notepad-auth-service

# Only the gateway should be reachable; in production bind to an internal interface
# HOST=127.0.0.1
