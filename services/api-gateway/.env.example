NODE_ENV=development
PORT=3000
# HOST=0.0.0.0

# Internal service addresses (not exposed to clients)
AUTH_SERVICE_URL=http://localhost:3001
NOTES_SERVICE_URL=http://localhost:3002
UPSTREAM_TIMEOUT_MS=10000

# Comma-separated front-end origins allowed by CORS (no "*")
CORS_ORIGINS=http://localhost:5173

# Number of load balancers/proxies in front of the gateway. 0 = clients connect directly.
# Wrong values let clients spoof their IP (too high) or put everyone behind one IP (too low).
TRUST_PROXY=0

# Rate limits (per client IP, per gateway instance)
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_MS=3600000
RATE_LIMIT_REFRESH_MAX=30
RATE_LIMIT_REFRESH_WINDOW_MS=60000
