# Settings for docker compose (copy to .env). Each service's own .env is for running it with npm.

# Shared by auth-service (signs) and notes-service (verifies); at least 32 chars: openssl rand -base64 48
JWT_ACCESS_SECRET=

# Password for the compose Postgres, used in connection URLs, so keep it URL-safe: openssl rand -hex 24
# Applied only when the postgres-data volume is first created (docker compose down -v to change it)
POSTGRES_PASSWORD=

# Host ports
GATEWAY_PORT=3000
POSTGRES_PORT=5432

# Front-end origins allowed by the gateway's CORS policy (comma-separated)
CORS_ORIGINS=http://localhost:5173
